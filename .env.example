# ==============================================================================
# AI SWARM: CONFIGURATION SETTINGS
# ==============================================================================

# System Settings
PROJECT_NAME="AI Swarm: From Individual to Intelligent Teams"
VERSION="1.0.0"

# LLM Configuration
# Optional: Provide OpenAI API Key for GPT-4o. If omitted, high-fidelity Demo Mode is used automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mode Toggle: Set to 'true' for offline deterministic benchmark simulation, or 'false' for live OpenAI API
DEMO_MODE=true

# Database Configuration (Defaults to local SQLite, compatible with PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_swarm
DATABASE_URL=sqlite:///ai_swarm.db

# Multi-Agent Coordination Settings
MAX_TEST_RETRIES=3
